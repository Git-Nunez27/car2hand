// เพิ่มการเรียกใช้ multer และ path ด้านบนสุดของไฟล์
const multer = require('multer');
const path = require('path');

// -----------------------------------------
// ตั้งค่า Multer สำหรับการจัดเก็บไฟล์
// -----------------------------------------
const storage = multer.diskStorage({
    destination: (req, file, cb) => {
        cb(null, 'uploads/'); // ไฟล์จะถูกเก็บไว้ในโฟลเดอร์ uploads (ต้องสร้างโฟลเดอร์นี้ไว้ด้วย)
    },
    filename: (req, file, cb) => {
        // ตั้งชื่อไฟล์ใหม่ด้วย Timestamp เพื่อป้องกันชื่อไฟล์ซ้ำกัน
        cb(null, Date.now() + path.extname(file.originalname)); 
    }
});
const upload = multer({ storage: storage });

// เปิดให้เข้าถึงโฟลเดอร์ uploads ผ่าน URL ได้โดยตรง (สำหรับให้หน้าเว็บดึงรูปไปแสดง)
app.use('/uploads', express.static('uploads'));

// -----------------------------------------
// API สำหรับอัปโหลดรูปภาพรถยนต์ (รองรับอัปโหลดพร้อมกันสูงสุด 5 รูป)
// -----------------------------------------
app.post('/api/cars/:car_id/images', upload.array('images', 5), (req, res) => {
    const carId = req.params.car_id;
    const files = req.files;

    if (!files || files.length === 0) { 
        return res.status(400).json({ error: 'กรุณาแนบไฟล์รูปภาพ' });
    }

    // สร้างชุดข้อมูลเพื่อบันทึกลง SQL แบบ Multiple Insert
    const imageRecords = files.map(file => [carId, `/uploads/${file.filename}`]);
    const sql = "INSERT INTO car_images (car_id, image_url) VALUES ?";

    db.query(sql, [imageRecords], (err, result) => {
        if (err) return res.status(500).json({ error: err.message });
        res.status(201).json({ 
            message: 'อัปโหลดรูปภาพสำเร็จ', 
            uploadedfiles: files.length 
        });
    });
});